---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import Card from './ui/Card.astro';
import Button from './ui/Button.astro';
import type { Lang } from '../data/types';
import { t, formatYearMonth } from '../data/i18n';
import { certificates } from '../data/certificates';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);

// Certificate images live in src/assets/certificates/<id>.<ext>, so dropping in a new
// file is enough: dimensions are read at build time and thumbnails are generated.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/certificates/*.{png,jpg,jpeg,webp,avif}', {
  eager: true,
});

function imageFor(id: string): ImageMetadata {
  const matches = Object.entries(files).filter(([path]) => path.split('/').pop()?.replace(/\.[^.]+$/, '') === id);
  const match = matches[0];
  if (!match || matches.length > 1) {
    throw new Error(
      match
        ? `Several images found for certificate "${id}" in src/assets/certificates/. Keep only one.`
        : `No image found for certificate "${id}". Add src/assets/certificates/${id}.png (or .jpg/.webp).`,
    );
  }
  return match[1].default;
}

const items = await Promise.all(
  certificates.map(async (certificate) => {
    const image = imageFor(certificate.id);
    const full = await getImage({ src: image, width: Math.min(image.width, 1800), format: 'webp', quality: 85 });
    return { ...certificate, image, full };
  }),
);
---

<section id="certificates" class="section" aria-labelledby="certificates-title">
  <div class="container">
    <SectionHeading
      id="certificates-title"
      num="05"
      title={s.sections.certificates}
      accent={2}
      intro={s.certificates.intro}
    />

    <ul class="grid" role="list">
      {
        items.map((item, index) => {
          const title = item.title[lang];
          return (
            <li data-reveal style={`--reveal-delay: ${(index % 2) * 100}ms`}>
              <Card as="article" class="cert">
                <a
                  class="thumb"
                  href={item.full.src}
                  target="_blank"
                  rel="noopener"
                  data-lightbox
                  data-title={title}
                  data-width={String(item.full.attributes.width ?? item.image.width)}
                  data-height={String(item.full.attributes.height ?? item.image.height)}
                >
                  <Image
                    src={item.image}
                    alt=""
                    widths={[360, 560, 720, 960]}
                    sizes="(min-width: 75em) 34rem, (min-width: 48em) 44vw, calc(100vw - 3rem)"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="sr-only">
                    {s.certificates.viewFull} {title}
                    <span data-newtab-note> {s.a11y.newTab}</span>
                  </span>
                </a>
                <div class="body">
                  <h3 class="title">{title}</h3>
                  <dl class="meta">
                    <div>
                      <dt>{s.certificates.issuer}</dt>
                      <dd>{item.issuer}</dd>
                    </div>
                    {item.date && (
                      <div>
                        <dt>{s.certificates.date}</dt>
                        <dd>
                          <time datetime={item.date}>{formatYearMonth(item.date, lang)}</time>
                        </dd>
                      </div>
                    )}
                  </dl>
                  <Button
                    href={item.url}
                    external
                    newTabNote={s.a11y.newTab}
                    size="sm"
                    variant="card"
                    iconEnd="arrow-up-right"
                    class="verify"
                  >
                    {s.certificates.verify}
                    <span class="sr-only">: {title}</span>
                  </Button>
                </div>
              </Card>
            </li>
          );
        })
      }
    </ul>
  </div>

  <!-- Lightbox (progressive enhancement: without JS the thumbnails open in a new tab). -->
  <dialog class="lightbox" aria-labelledby="lightbox-title" data-lightbox-dialog>
    <div class="lightbox-bar">
      <h2 id="lightbox-title" class="lightbox-title" data-lightbox-title></h2>
      <div class="lightbox-actions">
        <Button
          href={items[0]?.full.src ?? '#'}
          external
          newTabNote={s.a11y.newTab}
          size="sm"
          variant="card"
          iconEnd="arrow-up-right"
          data-lightbox-original
        >
          {s.certificates.openOriginal}
        </Button>
        <Button type="button" size="icon" variant="card" icon="close" label={s.certificates.close} data-lightbox-close />
      </div>
    </div>
    <div class="lightbox-stage" data-lightbox-stage></div>
  </dialog>
</section>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
  const stage = dialog?.querySelector<HTMLElement>('[data-lightbox-stage]');
  const heading = dialog?.querySelector<HTMLElement>('[data-lightbox-title]');
  const original = dialog?.querySelector<HTMLAnchorElement>('[data-lightbox-original]');
  const closeButton = dialog?.querySelector<HTMLButtonElement>('[data-lightbox-close]');
  let trigger: HTMLElement | null = null;

  if (dialog && stage && typeof dialog.showModal === 'function') {
    const image = document.createElement('img');
    image.className = 'lightbox-img';
    image.decoding = 'async';
    stage.append(image);

    document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]').forEach((link) => {
      // With JS the thumbnail opens the dialog instead of a new tab.
      link.querySelector('[data-newtab-note]')?.remove();
      link.setAttribute('aria-haspopup', 'dialog');

      link.addEventListener('click', (event) => {
        // Let modified clicks (new tab / window) behave normally.
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();

        const title = link.dataset.title ?? '';
        image.width = Number(link.dataset.width) || 0;
        image.height = Number(link.dataset.height) || 0;
        image.alt = title;
        image.src = link.href;
        if (heading) heading.textContent = title;
        if (original) original.href = link.href;

        trigger = link;
        dialog.showModal();
        closeButton?.focus();
      });
    });

    closeButton?.addEventListener('click', () => dialog.close());

    // A click on the backdrop lands on the <dialog> itself.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('close', () => {
      trigger?.focus();
      trigger = null;
    });
  }
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: clamp(1.75rem, 1rem + 2vw, 2.5rem);
  }

  .grid :global(.cert) {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .thumb {
    display: block;
    overflow: hidden;
    background: var(--bg);
    border-bottom: var(--bw) solid var(--border);
  }

  .thumb :global(img) {
    width: 100%;
    height: auto;
    transition: transform 250ms var(--ease-out);
  }

  @media (hover: hover) {
    .thumb:hover :global(img) {
      transform: scale(1.03);
    }
  }

  .thumb:focus-visible {
    outline-offset: -6px;
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
  }

  .title {
    font-size: var(--fs-lg);
    line-height: 1.2;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
  }

  .meta dt {
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  :lang(ka) .meta dt {
    text-transform: none;
    letter-spacing: 0;
  }

  .meta dd {
    margin: 0;
    font-weight: 700;
  }

  .body :global(.verify) {
    margin-top: auto;
  }

  /* ---- Lightbox ----------------------------------------------------------- */
  .lightbox {
    width: min(100% - 2rem, 72rem);
    max-width: none;
    max-height: calc(100dvh - 2rem);
    /* The global reset zeroes margins; modal dialogs center themselves with auto. */
    margin: auto;
    padding: 0;
    overflow: auto;
    overscroll-behavior: contain;
    background: var(--card);
    color: var(--fg);
    border: var(--bw) solid var(--border);
    box-shadow: var(--shadow-lg);
  }

  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.78);
  }

  .lightbox-bar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    padding: 0.75rem 1rem;
    background: var(--accent-1);
    color: var(--on-accent);
    border-bottom: var(--bw) solid var(--border);
  }

  .lightbox-title {
    font-size: var(--fs-md);
    line-height: 1.25;
  }

  .lightbox-actions {
    display: flex;
    gap: 0.75rem;
    padding: 0 6px 6px 0;
  }

  .lightbox-stage {
    padding: clamp(0.75rem, 0.5rem + 1vw, 1.25rem);
    background: var(--bg);
  }

  .lightbox-stage :global(.lightbox-img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: calc(100dvh - 10rem);
    margin-inline: auto;
    object-fit: contain;
    border: var(--bw) solid var(--border);
  }

  :global(html:has(dialog[open])) {
    overflow: hidden;
  }
</style>
