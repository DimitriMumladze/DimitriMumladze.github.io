---
import { Picture } from 'astro:assets';
import Button from './ui/Button.astro';
import Sticker from './ui/Sticker.astro';
import TagList from './ui/TagList.astro';
import Icon from './Icon.astro';
import photo from '../assets/images/dimitri.jpg';
import type { Lang } from '../data/types';
import { t, highlight } from '../data/i18n';
import { person, links, headline } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
const [firstName, lastName] = person.nameLines[lang];

// Alternate the two highlight colors: 1st mark accent-1, 2nd accent-2, …
let markCount = 0;
const segments = highlight(headline[lang]).map((segment) => ({
  ...segment,
  alt: segment.mark && markCount++ % 2 === 1,
}));
---

<section class="hero pattern-dots" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <h1 id="hero-title" class="name caps">
        <span class="name-line">{firstName}</span>
        <span class="name-line">{lastName}</span>
      </h1>
      <p class="role">{person.role[lang]}</p>
      <p class="headline">
        {segments.map((segment) => (segment.mark ? <mark class:list={[segment.alt && 'hl-2']}>{segment.text}</mark> : segment.text))}
      </p>
      <p class="sub">{s.hero.sub}</p>
      <TagList tags={person.headlineTags} class="hero-tags" />
      <div class="ctas">
        <Button href={links.cv} download variant="accent-1" icon="download">{s.hero.downloadCv}</Button>
        <Button href="#contact" variant="card" iconEnd="arrow-right">{s.hero.contactMe}</Button>
        <div class="social">
          <Button
            href={links.github}
            external
            newTabNote={s.a11y.newTab}
            size="icon"
            icon="github"
            label={s.hero.github}
          />
          <Button
            href={links.linkedin}
            external
            newTabNote={s.a11y.newTab}
            size="icon"
            icon="linkedin"
            label={s.hero.linkedin}
          />
        </div>
      </div>
    </div>

    <div class="hero-visual">
      <div class="portrait">
        <Picture
          src={photo}
          alt={s.hero.photoAlt}
          widths={[320, 480, 640, 800, 960]}
          sizes="(min-width: 56em) 24rem, (min-width: 40em) 19rem, 15rem"
          formats={['avif', 'webp']}
          quality={72}
          priority
          class="portrait-img"
        />
      </div>
      <Sticker accent={2} rotate={6} class="hero-sticker">
        <Icon name="flag-ge" size={24} />
        {person.city[lang]}
      </Sticker>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.25rem, 1rem + 4vw, 5rem) clamp(3.5rem, 2rem + 5vw, 6.5rem);
  }

  .hero-grid {
    display: grid;
    gap: clamp(2.75rem, 1.5rem + 4vw, 4.5rem);
    align-items: center;
  }

  .hero-copy {
    min-width: 0;
  }

  /* ---- Name ---------------------------------------------------------------- */
  .name {
    font-family: var(--ff-name);
    font-size: var(--fs-hero);
    font-weight: 700;
    /* Fixed line boxes + no wrapping: swapping in the web font cannot shift the layout. */
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-wrap: nowrap;
    white-space: nowrap;
  }

  .name-line {
    display: block;
  }

  .name-line:last-child {
    /* A slight offset for a hand-set, poster-like feel. */
    padding-inline-start: 0.5em;
  }

  :lang(ka) .name {
    font-size: clamp(2.75rem, 1.6rem + 5.6vw, 6.25rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: 0;
    /* Mkhedruli descenders (ძ, ჟ…) reach well below the baseline. */
    padding-bottom: 0.18em;
  }

  :lang(ka) .name-line:last-child {
    padding-inline-start: 0.35em;
  }

  /* ---- Role, headline, sub ------------------------------------------------- */
  .role {
    display: inline-block;
    margin-top: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    padding: 0.4em 0.75em;
    background: var(--inverse-bg);
    color: var(--inverse-fg);
    font-family: var(--ff-mono);
    font-size: var(--fs-sm);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.02em;
  }

  .headline {
    max-width: 24ch;
    margin-top: 1.25rem;
    font-size: clamp(1.6rem, 1.15rem + 1.8vw, 2.5rem);
    font-weight: 700;
    line-height: 1.22;
    letter-spacing: -0.015em;
  }

  .headline mark {
    padding-inline: 0.12em;
    border: var(--bw-sm) solid var(--border);
  }

  :lang(ka) .headline {
    max-width: 30ch;
    font-size: clamp(1.35rem, 1rem + 1.4vw, 2rem);
    line-height: 1.45;
    letter-spacing: 0;
  }

  .sub {
    max-width: 54ch;
    margin-top: 1rem;
    color: var(--muted);
    font-size: var(--fs-md);
    line-height: 1.5;
  }

  :lang(ka) .sub {
    font-size: var(--fs-base);
    line-height: 1.7;
  }

  .hero-copy :global(.hero-tags) {
    margin-top: 1.5rem;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .social {
    display: flex;
    gap: 1rem;
  }

  /* ---- Portrait ------------------------------------------------------------ */
  .hero-visual {
    position: relative;
    justify-self: center;
    width: min(100% - 1.5rem, 15rem);
  }

  .portrait {
    padding: clamp(0.55rem, 0.4rem + 0.6vw, 0.9rem);
    background: var(--accent-1);
    border: var(--bw) solid var(--border);
    box-shadow: var(--shadow-lg);
    transform: rotate(-3deg);
  }

  .portrait :global(picture),
  .portrait :global(img) {
    display: block;
    width: 100%;
  }

  .portrait :global(img) {
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    background: var(--card);
    border: var(--bw) solid var(--border);
  }

  .hero-visual :global(.hero-sticker) {
    position: absolute;
    bottom: -1.1rem;
    left: -0.9rem;
    z-index: 1;
  }

  /* Mobile & tablet: portrait first, then the text. */
  @media (max-width: 55.99em) {
    .hero-visual {
      order: -1;
    }
  }

  @media (min-width: 40em) {
    .hero-visual {
      width: 19rem;
    }
  }

  @media (min-width: 56em) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    }

    .hero-visual {
      justify-self: end;
      width: min(100% - 1rem, 24rem);
      margin-inline-end: 0.5rem;
    }

    .hero-visual :global(.hero-sticker) {
      bottom: -1.25rem;
      left: -1.5rem;
    }
  }
</style>
