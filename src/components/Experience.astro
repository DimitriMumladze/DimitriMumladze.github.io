---
import SectionHeading from './SectionHeading.astro';
import Card from './ui/Card.astro';
import Button from './ui/Button.astro';
import TagList from './ui/TagList.astro';
import Icon from './Icon.astro';
import type { Lang } from '../data/types';
import { t, formatYearMonth, PRESENT } from '../data/i18n';
import { experience, companyLabel } from '../data/experience';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
const markerAccents = [1, 2, 3] as const;
---

<section id="experience" class="section" aria-labelledby="experience-title">
  <div class="container">
    <SectionHeading id="experience-title" num="02" title={s.sections.experience} accent={2} />

    <ol class="timeline" role="list">
      {
        experience.map((item, index) => {
          const company = companyLabel[item.company]?.[lang] ?? item.company;
          return (
            <li class="entry" data-reveal>
              <span class={`marker marker--a${markerAccents[index % 3]}`} aria-hidden="true" />
              <Card as="article" class="entry-card">
                <header class="entry-head">
                  <div class="entry-title">
                    <h3 class="role">{item.role[lang]}</h3>
                    <p class="company">
                      {item.companyUrl ? (
                        <a href={item.companyUrl} target="_blank" rel="noopener">
                          {company}
                          <Icon name="arrow-up-right" size={16} />
                          <span class="sr-only"> {s.a11y.newTab}</span>
                        </a>
                      ) : (
                        <span class="company-name">{company}</span>
                      )}
                      {item.note && <span class="note"> · {item.note[lang]}</span>}
                    </p>
                  </div>
                  <p class="period">
                    <time datetime={item.period.start}>{formatYearMonth(item.period.start, lang)}</time>
                    {' – '}
                    {item.period.end ? (
                      <time datetime={item.period.end}>{formatYearMonth(item.period.end, lang)}</time>
                    ) : (
                      PRESENT[lang]
                    )}
                  </p>
                </header>

                {item.bullets && (
                  <ul class="bullets" role="list">
                    {item.bullets[lang].map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                )}

                {item.groups?.map((group) => (
                  <div class="client">
                    <h4 class="client-title">
                      {group.url ? (
                        <a href={group.url} target="_blank" rel="noopener">
                          {group.title}
                          <Icon name="arrow-up-right" size={16} />
                          <span class="sr-only"> {s.a11y.newTab}</span>
                        </a>
                      ) : (
                        group.title
                      )}
                    </h4>
                    <ul class="bullets" role="list">
                      {group.bullets[lang].map((bullet) => (
                        <li>{bullet}</li>
                      ))}
                    </ul>
                  </div>
                ))}

                <div class="entry-foot">
                  <TagList tags={item.tags} />
                  {item.certificateUrl && (
                    <Button
                      href={item.certificateUrl}
                      external
                      newTabNote={s.a11y.newTab}
                      size="sm"
                      variant="accent-1"
                      iconEnd="arrow-up-right"
                    >
                      {s.experience.certificate}
                    </Button>
                  )}
                </div>
              </Card>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    --pad: clamp(2rem, 1.25rem + 2.5vw, 3.25rem);
    --rail: 0.7rem;
    --dot: 1.3rem;
    position: relative;
    display: grid;
    gap: clamp(1.75rem, 1rem + 2vw, 2.75rem);
    padding-inline-start: var(--pad);
  }

  /* The vertical rail. */
  .timeline::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: calc(var(--rail) - var(--bw) / 2);
    width: var(--bw);
    background: var(--border);
  }

  .entry {
    position: relative;
  }

  .marker {
    position: absolute;
    top: 1.6rem;
    left: calc(var(--rail) - var(--dot) / 2 - var(--pad));
    width: var(--dot);
    height: var(--dot);
    background: var(--accent-1);
    border: var(--bw) solid var(--border);
    box-shadow: 2px 2px 0 var(--shadow-color);
  }

  .marker--a2 {
    background: var(--accent-2);
  }

  .marker--a3 {
    background: var(--accent-3);
  }

  .entry :global(.entry-card) {
    padding: clamp(1.25rem, 0.9rem + 1.5vw, 2rem);
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-bottom: 1.25rem;
  }

  .entry-title {
    min-width: 0;
    flex: 1 1 22rem;
  }

  .role {
    font-size: var(--fs-lg);
    line-height: 1.2;
  }

  .company {
    margin-top: 0.35rem;
    font-weight: 600;
  }

  .company a :global(.icon),
  .client-title a :global(.icon) {
    margin-inline-start: 0.2em;
    vertical-align: -0.1em;
  }

  .company a {
    font-weight: 700;
  }

  .note {
    color: var(--muted);
    font-weight: 500;
  }

  .period {
    flex: none;
    padding: 0.35em 0.65em;
    background: var(--inverse-bg);
    color: var(--inverse-fg);
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    line-height: 1.3;
    white-space: nowrap;
  }

  .bullets {
    display: grid;
    gap: 0.65rem;
    max-width: 82ch;
  }

  .bullets li {
    position: relative;
    padding-inline-start: 1.35rem;
  }

  .bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    top: calc(0.5lh - 0.25rem);
    width: 0.5rem;
    height: 0.5rem;
    background: var(--fg);
  }

  .client + .client {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: var(--bw-sm) dashed var(--border);
  }

  .client-title {
    margin-bottom: 0.85rem;
    font-size: var(--fs-md);
    line-height: 1.25;
  }

  /* Narrow phones: drop the side rail so the text gets the whole card width. */
  @media (max-width: 29.99em) {
    .timeline {
      padding-inline-start: 0;
    }

    .timeline::before,
    .marker {
      display: none;
    }

    .entry :global(.entry-card) {
      padding: 1.1rem;
    }

    .bullets li {
      padding-inline-start: 1.1rem;
    }
  }

  .entry-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-top: 1.5rem;
  }
</style>
