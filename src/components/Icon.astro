---
import { icons, type IconName } from './icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
const icon = icons[name];
const [, , w = 24, h = 24] = icon.viewBox.split(' ').map(Number);
// Keep the icon's aspect ratio (the flag is 3:2).
const width = size;
const height = Math.round((size * h) / w);
---

<svg
  class:list={['icon', className]}
  viewBox={icon.viewBox}
  width={width}
  height={height}
  aria-hidden="true"
  focusable="false"
  set:html={icon.body}
/>

<style>
  .icon {
    flex: none;
    display: inline-block;
    vertical-align: middle;
  }
</style>
