---
interface Props {
  tags: readonly string[];
  /** Accessible name for the list, e.g. "Tech stack". */
  label?: string;
  class?: string;
}

const { tags, label, class: className } = Astro.props;
---

<ul class:list={['tags', className]} role="list" aria-label={label}>
  {tags.map((tag) => <li class="tag">{tag}</li>)}
</ul>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag {
    padding: 0.3em 0.6em;
    background: var(--bg);
    color: var(--fg);
    border: var(--bw-sm) solid var(--border);
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    line-height: 1.3;
  }
</style>
